MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=OpenSquad
MC_AUTH=offline
# Leave empty to auto-detect. Example: 1.21.1
MC_VERSION=
# Comma-separated player names; empty allows all players on your private server.
ALLOWED_PLAYERS=
COMMAND_PREFIX=!bot
MEMORY_PATH=data/memory.json
COLLECT_RADIUS=32
MAX_COLLECT=16
ACTION_TIMEOUT_MS=45000
HOSTILE_RADIUS=12
# mock (default), or openai-compatible; commands work with either.
BRAIN_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
